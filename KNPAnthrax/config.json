{
  "globals": {
    "deltaT": 8,
    "startPoint": "2000-01-01T00:00:00",
    "endPoint": "2000-03-07T11:59:59",
    "deltaTUnit": "hours",
    "console": false,
    "output": "csv",
    "options": {
      "delimiter": ";",
      "format": "en-EN"
    }
  },
  "layers": [
    {
      "name": "LandscapeLayer",
      "file": "Resources/Northern KNP landscape.geojson"
    },
    {
      "name": "Perimeter",
      "file": "Resources/perimeter.geojson"
    },
    {
      "name": "AnthraxLayer",
      "file": "Resources/Northern KNP Anthrax.asc",
      "mapping": [
        {
          "parameter": "WriteHeatMapToFileEveryXTicks",
          "value": 21
        }
      ]
    },
    {
      "name":"WaterLayer",
      "file":"Resources/water/knp_water_north_merged.geojson"
    },
    {
      "name": "KuduMovement",
      "file": "Resources/Northern KNP.asc"
    },
    {
      "name": "ImpalaMovement",
      "file": "Resources/Northern KNP.asc"
    }
  ],
  "agents": [
    {
      "name": "Kudu",
      "count": 1,
      "file":"Resources/kudus.csv",
      "outputs": [
        {"kind": "csv"}
      ],
      "outputFilter": [{
        "parameter": "StoreTickResult",
        "operator": "in",
        "values": [true]
      }],
      "mapping": [
        {
          "parameter": "SpawnMinEnergy",
          "value": 50
        },
        {
          "parameter": "SpawnMaxEnergy",
          "value": 100
        },
        {
          "parameter": "SpawnWoodlandProbability",
          "value": 0.95
        },
        {
          "parameter": "SpawnSavannaProbability",
          "value": 0.05
        },
        {
          "parameter": "MinMovementPerTickInM",
          "value": 1500
        },
        {
          "parameter": "MaxMovementPerTickInM",
          "value": 2000
        },
        {
          "parameter": "MovementOnWoodland",
          "value": 0.90 
        },
        {
          "parameter": "MovementOnSavanna",
          "value": 0.10
        },
        {
          "parameter": "MaxDistanceFromWaterInM",
          "value": 3500
        },
        {
          "parameter": "AnthraxInfectionProbability",
          "value": 0.4
        },
        {
          "parameter": "MinInfectionDurationInTicks",
          "value": 9 
        },
        {
          "parameter": "MaxInfectionDurationInTicks",
          "value": 42
        },
        {
          "parameter": "OutputAgentTrack",
          "value": true
        }
      ]
    },
    {
      "name": "Impala",
      "count": 1,
      "file":"Resources/impalas.csv",
      "outputs": [
        {"kind": "csv"}
      ],
      "outputFilter": [{
        "parameter": "StoreTickResult",
        "operator": "in",
        "values": [true]
      }],
      "mapping": [
        {
          "parameter": "SpawnMinEnergy",
          "value": 50
        },
        {
          "parameter": "SpawnMaxEnergy",
          "value": 100
        },
        {
          "parameter": "SpawnWoodlandProbability",
          "value": 0.40
        },
        {
          "parameter": "SpawnSavannaProbability",
          "value": 0.60
        },
        {
          "parameter": "MinMovementPerTickInM",
          "value": 500
        },
        {
          "parameter": "MaxMovementPerTickInM",
          "value": 1000
        },
        {
          "parameter": "MaxDistanceFromWaterInM",
          "value": 5000
        },
        {
          "parameter": "AnthraxInfectionProbability",
          "value": 0.4
        },
        {
          "parameter": "MinInfectionDurationInTicks",
          "value": 9
        },
        {
          "parameter": "MaxInfectionDurationInTicks",
          "value": 42
        },
        {
          "parameter": "OutputAgentTrack",
          "value": true
        }
      ]
    }
  ]
}
